{
  "name": "gemini-local-coder",
  "displayName": "Gemini Local Coder",
  "description": "A high-performance, self-contained coding assistant powered directly by the Gemini API.",
  "version": "3.6.4",
  "publisher": "Souparna Paul",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sOuL2000s/Gemini-customAPIkey--Copilot-VScode-Extention.git"
  },
  "engines": {
    "vscode": "^1.108.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:geminiCoderView",
    "onCommand:gemini-local-coder.openCommandPalette",
    "onLanguage:*"
  ],
  "main": "./out/extension.js",
  "dependencies": {
    "@google/genai": "^1.39.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gemini-local-coder-container",
          "title": "Gemini Coder",
          "icon": "media/gemini-icon.svg"
        }
      ]
    },
    "views": {
      "gemini-local-coder-container": [
        {
          "id": "geminiCoderView",
          "name": "Gemini Code Chat",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "gemini-local-coder.openCommandPalette",
        "title": "Gemini Coder: Open Command Palette",
        "category": "Gemini Coder"
      }

    ],
    "keybindings": [
      {
        "command": "gemini-local-coder.openCommandPalette",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Gemini Coder Configuration",
      "properties": {
        "gemini.activeApiKeyName": {
          "type": "string",
          "default": "",
          "description": "The name of the currently active Gemini API Key (managed via the sidebar panel).",
          "scope": "resource"
        },
        "gemini.storedApiKeys": {
          "type": "array",
          "default": [],
          "description": "Internal list of stored API key names (managed securely by the extension).",
          "scope": "resource",
          "isHidden": true
        },
        "gemini.chatModel": {
          "type": "string",
          "default": "gemini-2.5-flash",
          "description": "The Gemini model used for the sidebar chat view.",
          "enum": [
            "gemini-2.5-flash",
            "gemini-3-flash-preview",
            "gemini-3.1-flash-lite",
            "gemini-2.5-flash-lite",
            "gemini-3.1-pro-preview",
            "gemini-2.5-pro"
          ],
          "enumDescriptions": [
            "Gemini 2.5 Flash",
            "Gemini 3 Flash (Preview)",
            "Gemini 3.1 Flash-Lite",
            "Gemini 2.5 Flash-Lite",
            "Gemini 3.1 Pro (Preview)",
            "Gemini 2.5 Pro"
          ]
        },
        "gemini.inlineModel": {
          "type": "string",
          "default": "gemini-2.5-flash-lite",
          "description": "The Gemini model used for inline code completions (requires a fast model).",
          "enum": [
            "gemini-2.5-flash",
            "gemini-3-flash-preview",
            "gemini-3.1-flash-lite",
            "gemini-2.5-flash-lite",
            "gemini-3.1-pro-preview",
            "gemini-2.5-pro"
          ],
          "enumDescriptions": [
            "Gemini 2.5 Flash",
            "Gemini 3 Flash (Preview)",
            "Gemini 3.1 Flash-Lite",
            "Gemini 2.5 Flash-Lite",
            "Gemini 3.1 Pro (Preview)",
            "Gemini 2.5 Pro"
          ]
        },
        "gemini.latency.debounceMs": {
          "type": "number",
          "default": 500,
          "description": "The delay (in milliseconds) after typing stops before triggering a completion request (300ms to 700ms recommended).",
          "minimum": 100,
          "maximum": 2000
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "test": "node ./out/test/runTest.js",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.108.1",
    "@types/node": "^25.1.0",
    "@types/mocha": "^10.0.6",
    "@types/glob": "^8.1.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "@vscode/test-electron": "^2.3.9",
    "mocha": "^10.3.0",
    "glob": "^8.1.0"
  }
}
