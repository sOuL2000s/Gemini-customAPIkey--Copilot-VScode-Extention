{
  "name": "gemini-local-coder",
  "displayName": "Gemini Local Coder",
  "description": "A high-performance, self-contained coding assistant powered directly by the Gemini API.",
  "version": "1.0.0",
  "publisher": "YourName",
  "repository": {
    "type": "git",
    "url": "https://github.com/YourName/gemini-local-coder.git"
  },
  "engines": {
    "vscode": "^1.108.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:geminiCoderView",
    "onCommand:gemini-local-coder.openCommandPalette",
    "onLanguage:*"
  ],
  "main": "./out/extension.js",
  "dependencies": {
    "@google/genai": "^1.39.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gemini-local-coder-container",
          "title": "Gemini Coder",
          "icon": "media/gemini-icon.svg"
        }
      ]
    },
    "views": {
      "gemini-local-coder-container": [
        {
          "id": "geminiCoderView",
          "name": "Gemini Code Chat",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "gemini-local-coder.openCommandPalette",
        "title": "Gemini Coder: Open Command Palette",
        "category": "Gemini Coder"
      }

    ],
    "keybindings": [
      {
        "command": "gemini-local-coder.openCommandPalette",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g",
        "when": "editorTextFocus"
      }

    ],
    "configuration": {
      "title": "Gemini Coder Configuration",
      "properties": {
        "gemini.apiKey": {
          "type": "string",
          "default": "",
          "description": "Your Google Gemini API Key. Required for all AI suggestions.",
          "scope": "resource",
          "isSecret": true
        },
        "gemini.latency.debounceMs": {
          "type": "number",
          "default": 500,
          "description": "The delay (in milliseconds) after typing stops before triggering a completion request (300ms to 700ms recommended).",
          "minimum": 100,
          "maximum": 2000
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.108.1",
    "@types/node": "^25.1.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3"
  }
}
