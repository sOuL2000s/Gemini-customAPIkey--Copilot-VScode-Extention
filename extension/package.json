{
  "name": "gemini-local-coder",
  "displayName": "Gemini Local Coder",
  "description": "A high-performance, self-contained coding assistant powered directly by the Gemini API.",
  "version": "3.4.0",
  "publisher": "Souparna Paul",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sOuL2000s/Gemini-customAPIkey--Copilot-VScode-Extention.git"
  },
  "engines": {
    "vscode": "^1.108.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:geminiCoderView",
    "onCommand:gemini-local-coder.openCommandPalette",
    "onLanguage:*"
  ],
  "main": "./out/extension.js",
  "dependencies": {
    "@google/genai": "^1.39.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gemini-local-coder-container",
          "title": "Gemini Coder",
          "icon": "media/gemini-icon.svg"
        }
      ]
    },
    "views": {
      "gemini-local-coder-container": [
        {
          "id": "geminiCoderView",
          "name": "Gemini Code Chat",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "gemini-local-coder.openCommandPalette",
        "title": "Gemini Coder: Open Command Palette",
        "category": "Gemini Coder"
      }

    ],
    "keybindings": [
      {
        "command": "gemini-local-coder.openCommandPalette",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Gemini Coder Configuration",
      "properties": {
        "gemini.activeApiKeyName": {
          "type": "string",
          "default": "",
          "description": "The name of the currently active Gemini API Key (managed via the sidebar panel).",
          "scope": "resource"
        },
        "gemini.storedApiKeys": {
          "type": "array",
          "default": [],
          "description": "Internal list of stored API key names (managed securely by the extension).",
          "scope": "resource",
          "isHidden": true
        },
        "gemini.chatModel": {
          "type": "string",
          "default": "gemini-2.5-flash",
          "description": "The Gemini model used for the sidebar chat view.",
          "enum": [
            "gemini-2.5-flash",
            "gemini-2.5-pro",
            "gemini-2.0-flash",
            "gemini-2.0-flash-001",
            "gemini-2.0-flash-exp-image-generation",
            "gemini-2.0-flash-lite-001",
            "gemini-2.0-flash-lite",
            "gemini-flash-latest",
            "gemini-flash-lite-latest",
            "gemini-pro-latest",
            "gemini-2.5-flash-lite",
            "gemini-2.5-flash-image",
            "gemini-2.5-flash-lite-preview-09-2025",
            "gemini-3-pro-preview",
            "gemini-3-flash-preview",
            "gemini-3.1-pro-preview",
            "gemini-3.1-pro-preview-customtools",
            "gemini-3.1-flash-lite-preview",
            "gemini-3-pro-image-preview",
            "gemini-3.1-flash-image-preview",
            "gemini-robotics-er-1.5-preview",
            "gemini-2.5-computer-use-preview-10-2025"
          ],
          "enumDescriptions": [
            "Gemini 2.5 Flash",
            "Gemini 2.5 Pro",
            "Gemini 2.0 Flash",
            "Gemini 2.0 Flash 001",
            "Gemini 2.0 Flash Exp (Image Generation)",
            "Gemini 2.0 Flash Lite 001",
            "Gemini 2.0 Flash Lite",
            "Gemini Flash Latest",
            "Gemini Flash Lite Latest",
            "Gemini Pro Latest",
            "Gemini 2.5 Flash Lite",
            "Gemini 2.5 Flash (Image)",
            "Gemini 2.5 Flash Lite Preview (09-2025)",
            "Gemini 3 Pro Preview",
            "Gemini 3 Flash Preview",
            "Gemini 3.1 Pro Preview",
            "Gemini 3.1 Pro Preview (Custom Tools)",
            "Gemini 3.1 Flash Lite Preview",
            "Gemini 3 Pro Image Preview",
            "Gemini 3.1 Flash Image Preview",
            "Gemini Robotics ER 1.5 Preview",
            "Gemini 2.5 Computer Use Preview (10-2025)"
          ]
        },
        "gemini.inlineModel": {
          "type": "string",
          "default": "gemini-3-flash-preview",
          "description": "The Gemini model used for inline code completions (requires a fast model).",
          "enum": [
            "gemini-2.5-flash",
            "gemini-2.5-pro",
            "gemini-2.0-flash",
            "gemini-2.0-flash-001",
            "gemini-2.0-flash-exp-image-generation",
            "gemini-2.0-flash-lite-001",
            "gemini-2.0-flash-lite",
            "gemini-flash-latest",
            "gemini-flash-lite-latest",
            "gemini-pro-latest",
            "gemini-2.5-flash-lite",
            "gemini-2.5-flash-image",
            "gemini-2.5-flash-lite-preview-09-2025",
            "gemini-3-pro-preview",
            "gemini-3-flash-preview",
            "gemini-3.1-pro-preview",
            "gemini-3.1-pro-preview-customtools",
            "gemini-3.1-flash-lite-preview",
            "gemini-3-pro-image-preview",
            "gemini-3.1-flash-image-preview",
            "gemini-robotics-er-1.5-preview",
            "gemini-2.5-computer-use-preview-10-2025"
          ],
          "enumDescriptions": [
            "Gemini 2.5 Flash",
            "Gemini 2.5 Pro",
            "Gemini 2.0 Flash",
            "Gemini 2.0 Flash 001",
            "Gemini 2.0 Flash Exp (Image Generation)",
            "Gemini 2.0 Flash Lite 001",
            "Gemini 2.0 Flash Lite",
            "Gemini Flash Latest",
            "Gemini Flash Lite Latest",
            "Gemini Pro Latest",
            "Gemini 2.5 Flash Lite",
            "Gemini 2.5 Flash (Image)",
            "Gemini 2.5 Flash Lite Preview (09-2025)",
            "Gemini 3 Pro Preview",
            "Gemini 3 Flash Preview",
            "Gemini 3.1 Pro Preview",
            "Gemini 3.1 Pro Preview (Custom Tools)",
            "Gemini 3.1 Flash Lite Preview",
            "Gemini 3 Pro Image Preview",
            "Gemini 3.1 Flash Image Preview",
            "Gemini Robotics ER 1.5 Preview",
            "Gemini 2.5 Computer Use Preview (10-2025)"
          ]
        },
        "gemini.latency.debounceMs": {
          "type": "number",
          "default": 500,
          "description": "The delay (in milliseconds) after typing stops before triggering a completion request (300ms to 700ms recommended).",
          "minimum": 100,
          "maximum": 2000
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.108.1",
    "@types/node": "^25.1.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3"
  }
}
