{
  "name": "gemini-local-coder",
  "displayName": "Gemini Local Coder",
  "description": "A high-performance, self-contained coding assistant powered directly by the Gemini API.",
  "version": "3.3.0",
  "publisher": "Souparna Paul",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sOuL2000s/Gemini-customAPIkey--Copilot-VScode-Extention.git"
  },
  "engines": {
    "vscode": "^1.108.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:geminiCoderView",
    "onCommand:gemini-local-coder.openCommandPalette",
    "onLanguage:*"
  ],
  "main": "./out/extension.js",
  "dependencies": {
    "@google/genai": "^1.39.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gemini-local-coder-container",
          "title": "Gemini Coder",
          "icon": "media/gemini-icon.svg"
        }
      ]
    },
    "views": {
      "gemini-local-coder-container": [
        {
          "id": "geminiCoderView",
          "name": "Gemini Code Chat",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "gemini-local-coder.openCommandPalette",
        "title": "Gemini Coder: Open Command Palette",
        "category": "Gemini Coder"
      }

    ],
    "keybindings": [
      {
        "command": "gemini-local-coder.openCommandPalette",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Gemini Coder Configuration",
      "properties": {
        "gemini.activeApiKeyName": {
          "type": "string",
          "default": "",
          "description": "The name of the currently active Gemini API Key (managed via the sidebar panel).",
          "scope": "resource"
        },
        "gemini.storedApiKeys": {
          "type": "array",
          "default": [],
          "description": "Internal list of stored API key names (managed securely by the extension).",
          "scope": "resource",
          "isHidden": true
        },
        "gemini.chatModel": {
          "type": "string",
          "default": "gemini-2.5-flash-preview-09-2025",
          "description": "The Gemini model used for the sidebar chat view.",
          "enum": [
            "gemini-2.5-flash",
            "gemini-2.5-pro",
            "gemini-2.0-flash",
            "gemini-2.0-flash-001",
            "gemini-2.0-flash-exp-image-generation",
            "gemini-2.0-flash-lite-001",
            "gemini-2.0-flash-lite",
            "gemini-exp-1206",
            "gemini-flash-latest",
            "gemini-flash-lite-latest",
            "gemini-pro-latest",
            "gemini-2.5-flash-lite",
            "gemini-2.5-flash-image",
            "gemini-2.5-flash-preview-09-2025",
            "gemini-2.5-flash-lite-preview-09-2025",
            "gemini-3-pro-preview",
            "gemini-3-flash-preview",
            "gemini-3-pro-image-preview",
            "gemini-robotics-er-1.5-preview",
            "gemini-2.5-computer-use-preview-10-2025",
            "gemini-embedding-001",
            "imagen-4.0-generate-preview-06-06",
            "imagen-4.0-ultra-generate-preview-06-06",
            "imagen-4.0-generate-001",
            "imagen-4.0-ultra-generate-001",
            "imagen-4.0-fast-generate-001",
            "gemini-2.5-flash-preview-tts",
            "gemini-2.5-pro-preview-tts",
            "gemini-2.5-flash-native-audio-latest",
            "gemini-2.5-flash-native-audio-preview-09-2025",
            "gemini-2.5-flash-native-audio-preview-12-2025",
            "gemma-3-1b-it",
            "gemma-3-4b-it",
            "gemma-3-12b-it",
            "gemma-3-27b-it",
            "gemma-3n-e4b-it",
