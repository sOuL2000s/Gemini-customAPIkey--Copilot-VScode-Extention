# -------------------------
# SECURITY / SECRETS
# -------------------------
# The API key must never be committed.
backend/.env

# -------------------------
# PYTHON BACKEND ARTIFACTS
# -------------------------
# Virtual environment folder
backend/venv/

# Byte-compiled files
backend/__pycache__/
*.pyc

# Distribution/packaging artifacts
*.egg-info/
.mypy_cache/
.pytest_cache/

# -------------------------
# NODE / TYPESCRIPT ARTIFACTS
# -------------------------
# Dependencies (installed via npm)
extension/node_modules/

# TypeScript compiled output
extension/out/
*.js.map

# Dependency lock files
# We ignore the lock file because we only provide requirements.txt (Python) 
# and package.json (Node) for simple setup.

# -------------------------
# VS CODE
# -------------------------
# Configuration files specific to a single user/workspace
.vscode/

# VS Code testing artifacts
.vscode-test/
.vscode-test-web/

# Ignore the vsix package file generated by vsce
*.vsix

# -------------------------
# OPERATING SYSTEM
# -------------------------
.DS_Store
Thumbs.db

combined_project_files.txt